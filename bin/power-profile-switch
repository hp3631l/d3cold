#!/usr/bin/env bash
# Power profile switcher for Lenovo LOQ 15IAX9E: Battery Deep Power Saving vs AC Balanced vs Gaming Performance

set -e

MODE="${1:-auto}"
AC_ONLINE=$(cat /sys/class/power_supply/ADP0/online 2>/dev/null || cat /sys/class/power_supply/ACAD/online 2>/dev/null || echo "0")
PROFILE_NODE="/sys/devices/platform/legion/platform-profile/platform-profile-0/profile"
FULLSPEED_NODE="/sys/devices/platform/legion/fan_fullspeed"
IGPU_MAX_FREQ_NODE="/sys/bus/pci/devices/0000:00:02.0/drm/card2/gt_max_freq_mhz"
DGPU_STATUS_NODE="/sys/bus/pci/devices/0000:01:00.0/power/runtime_status"

# Idempotent sysfs writer: skips redundant writes to prevent triggering Lenovo EC WMI SmartFan wakeups
_write_legion() {
    local node="$1"
    local val="$2"
    if [ -f "$node" ]; then
        local cur
        cur=$(cat "$node" 2>/dev/null || true)
        if [ "$cur" = "$val" ]; then
            return 0
        fi
    fi
    sudo -n /usr/local/bin/omalegion-write write "$node" "$val" > /dev/null 2>&1 || true
}

_apply_cpu() {
    local profile="$1"
    if command -v powerprofilesctl >/dev/null 2>&1; then
        local cur_prof
        cur_prof=$(powerprofilesctl get 2>/dev/null || true)
        if [ "$cur_prof" != "$profile" ]; then
            powerprofilesctl set "$profile" >/dev/null 2>&1 || true
        fi
    fi
    if command -v ryoku-power >/dev/null 2>&1; then
        sudo -n /usr/local/bin/ryoku-power apply-profile "$profile" > /dev/null 2>&1 || true
    fi
}

WIFI_IFACE=$(iw dev 2>/dev/null | awk '$1=="Interface"{print $2; exit}')

_set_wifi_powersave() {
    local state="$1"
    if [ -n "$WIFI_IFACE" ]; then
        local cur_state
        cur_state=$(iw dev "$WIFI_IFACE" get power_save 2>/dev/null | awk '{print $3}' || true)
        if [ "$cur_state" != "$state" ]; then
            iw dev "$WIFI_IFACE" set power_save "$state" 2>/dev/null || true
        fi
    fi
}

if [ "$MODE" = "game" ] || [ "$MODE" = "full" ] || [ "$MODE" = "custom" ]; then
    echo "🎮 Switching to GAMING / MAXIMUM PERFORMANCE MODE"
    
    # 1. CPU profile to performance (governor: performance, EPP: performance, maxFreq: 100%)
    _apply_cpu "performance"
    
    # 2. Restore full Intel iGPU boost frequency (1450 MHz)
    _write_legion "$IGPU_MAX_FREQ_NODE" "1450"
    
    # 3. Disable WiFi power saving for minimum online latency
    _set_wifi_powersave "off"

    # 4. PCIe performance (WiFi, Ethernet on)
    _write_legion "/sys/bus/pci/devices/0000:00:14.3/power/control" "on"
    _write_legion "/sys/bus/pci/devices/0000:00:15.0/power/control" "on"
    _write_legion "/sys/bus/pci/devices/0000:00:15.1/power/control" "on"
    _write_legion "/sys/bus/pci/devices/0000:00:01.0/power/control" "on"
    
    # 5. Switch Lenovo profile to custom (required for fan_fullspeed)
    _write_legion "$PROFILE_NODE" "custom"
    
    # 6. Turn on full speed fan (5600 RPM max hardware speed)
    _write_legion "$FULLSPEED_NODE" "1"
    
    echo "✅ Gaming mode active: Max CPU/iGPU Clocks, Fan MAX (5600 RPM)."
    exit 0
fi

if [ "$AC_ONLINE" = "1" ] || [ "$MODE" = "ac" ] || [ "$MODE" = "balance" ]; then
    echo "⚡ AC Power detected -> Restoring DEFAULT / NORMAL BALANCED STATE"
    
    # 1. Restore CPU profile to balanced (governor: powersave, EPP: balance_performance, maxFreq: 100%)
    _apply_cpu "balanced"
    
    # 2. Restore full Intel iGPU frequency (1450 MHz)
    _write_legion "$IGPU_MAX_FREQ_NODE" "1450"
    
    # 3. Turn off full speed fan forcing
    _write_legion "$FULLSPEED_NODE" "0"
    
    # 4. Restore Lenovo Platform Profile to balanced
    _write_legion "$PROFILE_NODE" "balanced"
    
    # 5. Disable WiFi power saving for responsive browsing/streaming
    _set_wifi_powersave "off"

    # 6. Restore PCIe performance on AC (WiFi)
    _write_legion "/sys/bus/pci/devices/0000:00:14.3/power/control" "on"
    _write_legion "/sys/bus/pci/devices/0000:00:15.0/power/control" "on"
    _write_legion "/sys/bus/pci/devices/0000:00:15.1/power/control" "on"
    _write_legion "/sys/bus/pci/devices/0000:00:01.0/power/control" "on"
    
    echo "✅ System restored to normal balanced AC state."

else
    echo "🔋 Battery detected -> Applying DEEP POWER SAVING (<10W Target)"
    
    # 1. CPU profile to power-saver (governor: powersave, EPP: power, maxFreq: 50%)
    _apply_cpu "power-saver"
    
    # 2. Clamp Intel iGPU max frequency to 400 MHz (saves ~1.0W–1.5W of System Agent draw)
    _write_legion "$IGPU_MAX_FREQ_NODE" "400"
    
    # 3. Turn off full speed fan forcing
    _write_legion "$FULLSPEED_NODE" "0"
    
    # 4. Set Lenovo Platform Profile to low-power (Quiet Mode)
    _write_legion "$PROFILE_NODE" "low-power"
    
    # 5. Enable WiFi power saving
    _set_wifi_powersave "on"

    # 6. Enable runtime PM on non-critical PCIe devices (Ethernet, WiFi)
    _write_legion "/sys/bus/pci/devices/0000:07:00.0/power/control" "auto"
    _write_legion "/sys/bus/pci/devices/0000:00:14.3/power/control" "auto"

    # 7. Protect critical host controllers and buses
    # Touchpad I2C controllers must remain ON
    _write_legion "/sys/bus/pci/devices/0000:00:15.0/power/control" "on"
    _write_legion "/sys/bus/pci/devices/0000:00:15.1/power/control" "on"
    # Root port for dGPU must remain ON to avoid link timeouts and shutdown hangs
    _write_legion "/sys/bus/pci/devices/0000:00:01.0/power/control" "on"
    
    echo "✅ Deep battery power saving active."
    
    # Check current discharge rate
    if [ -f /sys/class/power_supply/BAT0/power_now ]; then
        NOW=$(cat /sys/class/power_supply/BAT0/power_now)
        WATTS=$(awk "BEGIN {printf \"%.2f\", $NOW/1000000}")
        echo "📊 Current Battery Draw: ${WATTS} W"
    fi
fi
