#!/usr/bin/env bash
# Universal Power Profile Switcher: Battery Deep Power Saving vs AC Balanced vs Gaming Performance
# Portable across all laptop vendors (Lenovo, ASUS, Dell, HP, Acer, Framework, Intel, AMD, etc.)

MODE="${1:-auto}"

# 1. Universal AC detection across any kernel / power supply naming scheme
is_ac_online() {
    # Check power supplies of type Mains or USB
    for ps in /sys/class/power_supply/*; do
        [ -d "$ps" ] || continue
        local ptype
        ptype=$(cat "$ps/type" 2>/dev/null || true)
        if [ "$ptype" = "Mains" ] || [ "$ptype" = "USB" ]; then
            if [ "$(cat "$ps/online" 2>/dev/null)" = "1" ]; then
                return 0
            fi
        fi
    done
    # Fallback: check AC* or ADP* nodes
    for ps in /sys/class/power_supply/AC* /sys/class/power_supply/ADP*; do
        [ -e "$ps/online" ] || continue
        if [ "$(cat "$ps/online" 2>/dev/null)" = "1" ]; then
            return 0
        fi
    done
    # Fallback: check battery status (Charging / Full => on AC)
    for bat in /sys/class/power_supply/BAT* /sys/class/power_supply/*battery*; do
        [ -d "$bat" ] || continue
        local bstat
        bstat=$(cat "$bat/status" 2>/dev/null || true)
        if [ "$bstat" = "Charging" ] || [ "$bstat" = "Full" ]; then
            return 0
        fi
    done
    return 1
}

if is_ac_online; then
    AC_ONLINE=1
else
    AC_ONLINE=0
fi

# 2. Universal CPU and ACPI Platform Profile
_apply_profile() {
    local profile="$1" # "performance", "balanced", or "power-saver"
    
    # Desktop standard daemon (power-profiles-daemon)
    if command -v powerprofilesctl >/dev/null 2>&1; then
        powerprofilesctl set "$profile" 2>/dev/null || true
    fi
    
    # Kernel ACPI platform_profile standard (all vendors)
    local acpi_profile_node="/sys/firmware/acpi/platform_profile"
    local acpi_choices_node="/sys/firmware/acpi/platform_profile_choices"
    if [ -w "$acpi_profile_node" ] && [ -f "$acpi_choices_node" ]; then
        local choices
        choices=$(cat "$acpi_choices_node" 2>/dev/null || true)
        local target=""
        case "$profile" in
            performance)
                if echo "$choices" | grep -qw "performance"; then target="performance"; fi
                ;;
            balanced)
                if echo "$choices" | grep -qw "balanced"; then target="balanced"; fi
                ;;
            power-saver)
                if echo "$choices" | grep -qw "low-power"; then
                    target="low-power"
                elif echo "$choices" | grep -qw "quiet"; then
                    target="quiet"
                fi
                ;;
        esac
        if [ -n "$target" ]; then
            echo "$target" > "$acpi_profile_node" 2>/dev/null || true
        fi
    fi

    # Vendor-specific fallbacks (only invoked if hardware node physically exists)
    # Lenovo Legion/LOQ
    local legion_node="/sys/devices/platform/legion/platform-profile/platform-profile-0/profile"
    if [ -f "$legion_node" ]; then
        local leg_target="$profile"
        if [ "$profile" = "power-saver" ]; then leg_target="low-power"; fi
        echo "$leg_target" | sudo -n tee "$legion_node" >/dev/null 2>&1 || true
    fi
    
    # ASUS ROG / TUF throttle_thermal_policy (0=normal, 1=boost, 2=silent)
    local asus_node="/sys/devices/platform/asus-nb-wmi/throttle_thermal_policy"
    if [ -f "$asus_node" ]; then
        local asus_val=0
        if [ "$profile" = "performance" ]; then asus_val=1; elif [ "$profile" = "power-saver" ]; then asus_val=2; fi
        echo "$asus_val" | sudo -n tee "$asus_node" >/dev/null 2>&1 || true
    fi
}

# 3. WiFi power management (Universal via iw)
WIFI_IFACE=$(iw dev 2>/dev/null | awk '$1=="Interface"{print $2; exit}')
_set_wifi_powersave() {
    local state="$1"
    if [ -n "$WIFI_IFACE" ]; then
        iw dev "$WIFI_IFACE" set power_save "$state" 2>/dev/null || true
    fi
}

# 4. Intel iGPU max frequency tuning (Only if Intel iGPU is present)
_tune_igpu() {
    local freq="$1"
    for node in /sys/bus/pci/devices/*/drm/card*/gt_max_freq_mhz; do
        [ -f "$node" ] || continue
        echo "$freq" | sudo -n tee "$node" >/dev/null 2>&1 || true
    done
}

if [ "$MODE" = "game" ] || [ "$MODE" = "full" ] || [ "$MODE" = "custom" ]; then
    echo "🎮 Switching to GAMING / MAXIMUM PERFORMANCE MODE"
    _apply_profile "performance"
    _set_wifi_powersave "off"
    _tune_igpu "1450"
    
    # Optional Lenovo full speed fan if hardware node exists
    if [ -f "/sys/devices/platform/legion/fan_fullspeed" ]; then
        echo "1" | sudo -n tee "/sys/devices/platform/legion/fan_fullspeed" >/dev/null 2>&1 || true
    fi
    echo "✅ Gaming mode active: Performance profile applied."
    exit 0
fi

if [ "$AC_ONLINE" = "1" ] || [ "$MODE" = "ac" ] || [ "$MODE" = "balance" ]; then
    echo "⚡ AC Power detected -> Restoring DEFAULT / NORMAL BALANCED STATE"
    _apply_profile "balanced"
    _set_wifi_powersave "off"
    _tune_igpu "1450"
    
    if [ -f "/sys/devices/platform/legion/fan_fullspeed" ]; then
        echo "0" | sudo -n tee "/sys/devices/platform/legion/fan_fullspeed" >/dev/null 2>&1 || true
    fi
    echo "✅ System restored to normal balanced AC state."

else
    echo "🔋 Battery detected -> Applying DEEP POWER SAVING"
    _apply_profile "power-saver"
    _set_wifi_powersave "on"
    _tune_igpu "400"
    
    if [ -f "/sys/devices/platform/legion/fan_fullspeed" ]; then
        echo "0" | sudo -n tee "/sys/devices/platform/legion/fan_fullspeed" >/dev/null 2>&1 || true
    fi

    # Trigger d3cold suspend so dGPU safely sleeps on battery
    if command -v d3cold >/dev/null 2>&1; then
        d3cold suspend >/dev/null 2>&1 || true
    fi

    echo "✅ Deep battery power saving active."
    
    # Check current discharge rate
    for pnow in /sys/class/power_supply/*/power_now; do
        if [ -f "$pnow" ]; then
            NOW=$(cat "$pnow" 2>/dev/null || echo 0)
            if [ "$NOW" -gt 0 ] 2>/dev/null; then
                WATTS=$(awk "BEGIN {printf \"%.2f\", $NOW/1000000}")
                echo "📊 Current Battery Draw: ${WATTS} W"
                break
            fi
        fi
    done
fi
